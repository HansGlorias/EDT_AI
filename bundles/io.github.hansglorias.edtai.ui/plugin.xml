<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category
            id="io.github.hansglorias.edtai.ui.category"
            name="EDT AI">
      </category>
      <view
            id="io.github.hansglorias.edtai.ui.chatView"
            name="EDT AI"
            category="io.github.hansglorias.edtai.ui.category"
            class="io.github.hansglorias.edtai.ui.ChatView"
            icon="icons/edtai.png"
            allowMultiple="false"
            restorable="true">
      </view>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="io.github.hansglorias.edtai.ui.preferences"
            name="EDT AI"
            class="io.github.hansglorias.edtai.ui.AiPreferencePage">
      </page>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category
            id="io.github.hansglorias.edtai.ui.commands"
            name="EDT AI">
      </category>
      <command
            id="io.github.hansglorias.edtai.ui.openChat"
            categoryId="io.github.hansglorias.edtai.ui.commands"
            name="EDT AI"
            description="Открыть чат EDT AI">
      </command>
      <command
            id="io.github.hansglorias.edtai.ui.askAboutSelection"
            categoryId="io.github.hansglorias.edtai.ui.commands"
            name="Спросить AI о выделенном"
            description="Прикрепить к вопросу в чате AI выделенные строки, метод под курсором или модуль">
      </command>
      <command
            id="io.github.hansglorias.edtai.ui.explainSelection"
            categoryId="io.github.hansglorias.edtai.ui.commands"
            name="Объяснить"
            description="Объяснить выделенный код (или метод под курсором) в чате EDT AI">
      </command>
      <command
            id="io.github.hansglorias.edtai.ui.reviewSelection"
            categoryId="io.github.hansglorias.edtai.ui.commands"
            name="Ревью"
            description="Ревью выделенного кода (или метода под курсором) в чате EDT AI">
      </command>
      <command
            id="io.github.hansglorias.edtai.ui.refactorSelection"
            categoryId="io.github.hansglorias.edtai.ui.commands"
            name="Рефакторинг"
            description="Рефакторинг выделенного кода (или метода под курсором) моделью EDT AI">
      </command>
      <command
            id="io.github.hansglorias.edtai.ui.commitMessage"
            categoryId="io.github.hansglorias.edtai.ui.commands"
            name="Написать сообщение коммита"
            description="EDT AI посмотрит незакоммиченное и впишет сообщение коммита">
      </command>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="io.github.hansglorias.edtai.ui.openChat"
            class="io.github.hansglorias.edtai.ui.OpenChatHandler">
      </handler>
      <handler
            commandId="io.github.hansglorias.edtai.ui.askAboutSelection"
            class="io.github.hansglorias.edtai.ui.AskAboutSelectionHandler">
      </handler>
      <handler
            commandId="io.github.hansglorias.edtai.ui.explainSelection"
            class="io.github.hansglorias.edtai.ui.CodeActionHandler">
      </handler>
      <handler
            commandId="io.github.hansglorias.edtai.ui.reviewSelection"
            class="io.github.hansglorias.edtai.ui.CodeActionHandler">
      </handler>
      <handler
            commandId="io.github.hansglorias.edtai.ui.refactorSelection"
            class="io.github.hansglorias.edtai.ui.CodeActionHandler">
      </handler>
      <handler
            commandId="io.github.hansglorias.edtai.ui.commitMessage"
            class="io.github.hansglorias.edtai.ui.CommitMessageHandler">
      </handler>
   </extension>
   <!-- Контекст окна, а не textEditorScope: многостраничный редактор объекта EDT
        может не включать контекст текстового редактора у страницы модуля. -->
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="io.github.hansglorias.edtai.ui.askAboutSelection"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M3+A">
      </key>
   </extension>
   <!-- #TextEditorContext — меню текстовых редакторов Eclipse, его же использует
        BSL-редактор EDT на Xtext. Проверяется руками в EDT. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:#TextEditorContext?after=additions">
         <menu
               id="io.github.hansglorias.edtai.ui.editorMenu"
               icon="icons/edtai.png"
               label="EDT AI">
            <command
                  commandId="io.github.hansglorias.edtai.ui.askAboutSelection"
                  icon="icons/edtai.png"
                  label="Спросить о выделенном"
                  style="push">
            </command>
            <separator name="actions" visible="true"/>
            <command commandId="io.github.hansglorias.edtai.ui.explainSelection" style="push"/>
            <command commandId="io.github.hansglorias.edtai.ui.reviewSelection" style="push"/>
            <command commandId="io.github.hansglorias.edtai.ui.refactorSelection" style="push"/>
         </menu>
      </menuContribution>
      <!-- Панель окна коммита EGit (Git Staging): своя кнопка. Ссылка на вид по
           идентификатору, без зависимости от EGit: нет вида — нет и кнопки. -->
      <menuContribution locationURI="toolbar:org.eclipse.egit.ui.StagingView">
         <command
               commandId="io.github.hansglorias.edtai.ui.commitMessage"
               icon="icons/edtai.png"
               style="push"
               tooltip="Написать сообщение коммита (EDT AI): модель посмотрит незакоммиченное и впишет текст">
         </command>
      </menuContribution>
      <!-- Строка состояния внизу окна, где и виджеты других плагинов: значок и
           подпись «EDT AI», щелчок открывает чат. -->
      <menuContribution locationURI="toolbar:org.eclipse.ui.trim.status">
         <toolbar id="io.github.hansglorias.edtai.ui.statusToolbar">
            <command
                  commandId="io.github.hansglorias.edtai.ui.openChat"
                  icon="icons/edtai.png"
                  label="EDT AI"
                  mode="FORCE_TEXT"
                  style="push"
                  tooltip="Открыть чат EDT AI">
            </command>
         </toolbar>
      </menuContribution>
   </extension>
   <extension
         id="review"
         name="EDT AI: ревью"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="true"/>
   </extension>
   <!-- Своя форма значка отличает ревью модели от диагностики EDT.
        Тип и severity маркеров сохранены: работают и старые ревью. -->
   <extension point="org.eclipse.ui.ide.markerImageProviders">
      <imageprovider
            id="io.github.hansglorias.edtai.ui.reviewImage"
            markertype="io.github.hansglorias.edtai.ui.review"
            icon="icons/review.png"/>
   </extension>
   <extension point="org.eclipse.ui.editors.annotationTypes">
      <type name="io.github.hansglorias.edtai.ui.review.error"
            super="org.eclipse.ui.workbench.texteditor.error"
            markerType="io.github.hansglorias.edtai.ui.review" markerSeverity="2"/>
      <type name="io.github.hansglorias.edtai.ui.review.warning"
            super="org.eclipse.ui.workbench.texteditor.warning"
            markerType="io.github.hansglorias.edtai.ui.review" markerSeverity="1"/>
      <type name="io.github.hansglorias.edtai.ui.review.info"
            super="org.eclipse.ui.workbench.texteditor.info"
            markerType="io.github.hansglorias.edtai.ui.review" markerSeverity="0"/>
   </extension>
   <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification annotationType="io.github.hansglorias.edtai.ui.review.error"
            label="EDT AI: ошибка ревью" icon="icons/review_error.png"
            colorPreferenceKey="edtai.review.error.color" colorPreferenceValue="217,87,99"
            verticalRulerPreferenceKey="edtai.review.error.ruler" verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="edtai.review.error.overview" overviewRulerPreferenceValue="true"
            textPreferenceKey="edtai.review.error.text" textPreferenceValue="false"
            presentationLayer="3"/>
      <specification annotationType="io.github.hansglorias.edtai.ui.review.warning"
            label="EDT AI: предупреждение ревью" icon="icons/review_warning.png"
            colorPreferenceKey="edtai.review.warning.color" colorPreferenceValue="189,134,31"
            verticalRulerPreferenceKey="edtai.review.warning.ruler" verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="edtai.review.warning.overview" overviewRulerPreferenceValue="true"
            textPreferenceKey="edtai.review.warning.text" textPreferenceValue="false"
            presentationLayer="3"/>
      <specification annotationType="io.github.hansglorias.edtai.ui.review.info"
            label="EDT AI: информация ревью" icon="icons/review_info.png"
            colorPreferenceKey="edtai.review.info.color" colorPreferenceValue="81,141,206"
            verticalRulerPreferenceKey="edtai.review.info.ruler" verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="edtai.review.info.overview" overviewRulerPreferenceValue="true"
            textPreferenceKey="edtai.review.info.text" textPreferenceValue="false"
            presentationLayer="3"/>
   </extension>
</plugin>
